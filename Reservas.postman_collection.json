{
  "info": {
    "_postman_id": "f9da7244-e7ab-49bc-95b5-b55aa41032c5",
    "name": "Reservas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - Crear reserva (válida + API key)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"success es true\", () => pm.expect(pm.response.json().success).to.eql(true));",
              "pm.test(\"Incluye data y timestamp\", () => pm.expect(pm.response.json()).to.include.keys(\"data\", \"timestamp\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "x-api-key",
            "value": "restaurant-secret",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"Carlos Pérez\",\n  \"email\": \"carlos@email.com\",\n  \"people\": 4\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/reservations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "reservations"
          ]
        },
        "description": "Crea una reserva con datos válidos y la API key correcta. Esperado: 201 { success: true, data, timestamp }."
      },
      "response": []
    },
